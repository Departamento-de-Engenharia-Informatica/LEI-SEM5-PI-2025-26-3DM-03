@startuml US_3_2_5_C2_Logica
title US 3.2.5 - Lógica de atribuição de roles

component AdminUI as "Admin Page (Settings)"
component AdminCtrl as "AdminController"
component ActSvc as "ActivationLinkService"
database DB as "PortContext\nAppUsers, Roles, UserRoles"

AdminUI --> AdminCtrl : update roles/activate/deactivate
AdminCtrl --> DB : persist UserRoles/Active
AdminCtrl --> ActSvc : criar/reenviar activation ou role-change
ActSvc --> DB : ActivationToken

@enduml
