@startuml US_3_2_5_C3_Impl
title US 3.2.5 - Implementação (Admin roles)

component Page as "Admin Users Page\n(select user, assign roles)"
component Service as "Admin API client\ncalls /admin/users/*"
component AdminCtrl as "AdminController"
component ActSvc as "ActivationLinkService"
database DB as "PortContext"

Page --> Service : PUT /admin/users/{id}/role(s)\nPATCH activate/deactivate\nPOST activation-links\nPOST role-change-links
Service --> AdminCtrl : HTTP
AdminCtrl --> DB : update AppUser/UserRoles
AdminCtrl --> ActSvc : send activation/role-change email
ActSvc --> DB : ActivationToken store

@enduml
