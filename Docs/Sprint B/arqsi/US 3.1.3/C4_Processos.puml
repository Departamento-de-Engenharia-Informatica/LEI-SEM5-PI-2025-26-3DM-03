@startuml US_3_1_3_C4_Processos
title US 3.1.3 - Processo de autorização de navegação

actor User
participant Router as "Angular Router"
participant Guard as "AuthGuard"
participant Auth as "AuthService"

User -> Router: /settings
Router -> Guard: canActivate(data.roles)
Guard -> Auth: user.role?
alt role permitido
  Guard --> Router: allow
else role negado
  Guard --> Router: cancel
  Guard -> User: toast "Acesso negado" + redirect
end

@enduml
