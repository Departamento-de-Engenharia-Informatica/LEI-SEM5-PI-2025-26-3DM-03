@startuml US_3_1_3_C3_Impl
title US 3.1.3 - Implementação de menus

component Layout as "layout.component.ts\nmenuItems + displayedMenu"
component AuthSvc as "AuthService\nnormalize roles"
component Guard as "AuthGuard\ncanActivate"
component Routes as "app.routes.ts\n(data.roles)"

Layout --> AuthSvc : loggedIn$ / user
Layout --> Layout : displayedMenu = filter(menuItems, role)
Routes --> Guard
Guard --> AuthSvc : validate role

@enduml
