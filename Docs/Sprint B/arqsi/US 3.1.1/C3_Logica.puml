@startuml US_3_1_1_C3_Logica
title US 3.1.1 - SPA Setup (Logical UI)

package "Shell & Routing" {
  [app.routes.ts]
  [LayoutComponent]
  [AuthGuard]
}

package "Cross-cutting" {
  [AuthService]
  [TranslationService]
  [ToastService]
}

package "Feature Modules" {
  [VesselsPage]
  [VesselTypesPage]
  [VVNPage]
  [DocksPage]
  [StorageAreasPage]
  [ResourcesPage]
  [SchedulingPage]
  [PublicResourcesPage]
  [ShippingAgentsPage]
  [RepresentativesPage]
  [StaffPage]
  [SettingsPage]
}

[LayoutComponent] --> [AuthGuard]
[LayoutComponent] --> [AuthService]
[LayoutComponent] --> [TranslationService]
[LayoutComponent] --> [ToastService]
[LayoutComponent] --> [VesselsPage] : router-outlet\n(similar for other pages)
[AuthGuard] --> [AuthService] : auth/roles
[Feature Modules] --> [AuthService]
[Feature Modules] --> [ToastService]
[Feature Modules] --> [TranslationService]

@enduml
