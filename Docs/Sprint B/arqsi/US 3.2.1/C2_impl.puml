@startuml US_3_2_1_C2_Impl
title US 3.2.1 - Autenticacao IAM (Implementacao)

node "Browser" {
  component SPA as "AuthService/Login\nAngular SPA"
}

node "TodoApi" {
  component AuthTest as "AuthTestController\n/authtest/login|me|logout|token"
}

node "IAM Provider" {
  component OIDC as "OIDC (Google)\nAuthorization Code + PKCE"
}

SPA --> AuthTest : GET /authtest/login\nredirect 302
AuthTest --> OIDC : authorize?client_id+code_challenge
OIDC --> AuthTest : code + tokens
AuthTest --> SPA : set cookie + redirect\nhttps://localhost:4200/?auth=ok
SPA --> AuthTest : GET /authtest/me\nwithCredentials
AuthTest --> SPA : perfil + roles + access_token

@enduml
