@startuml US_3_2_1_C2_Logica
title US 3.2.1 - Lógica de autenticação IAM

component SPA as "AuthService/LoginComponent"
component AuthTest as "AuthTestController\n/authtest/login|me|logout|token"
component OIDC as "IAM Provider\n(OIDC Authorization Code + PKCE)"

SPA --> AuthTest : GET /authtest/login
AuthTest --> OIDC : redirect + PKCE
OIDC --> AuthTest : code + tokens
AuthTest --> SPA : auth cookie + redirect
SPA --> AuthTest : GET /authtest/me (profile+token)

@enduml
