@startuml US_3_1_5_C3_Impl
title US 3.1.5 - Implementação de páginas/forms

component Routes as "app.routes.ts\nroles: data.roles"
component Guard as "AuthGuard"
component Pages as "Standalone Pages\n(VVN, Storage, Resources, Docks, Vessels,\nShippingAgents, Staff, etc.)"
component Services as "Service layer\nfetch/HttpClient"
component Toast as "ToastService"

Routes --> Guard
Guard --> Pages : allow/deny
Pages --> Services : GET/POST/PUT/DELETE
Pages --> Toast : success/error
Services --> Pages : JSON data/errors

@enduml
