@startuml US_3_2_2_C2_Impl
title US 3.2.2 - Carregamento de roles (Implementacao)

node "Browser" {
  component SPA as "Layout/AuthService\ncarrega roles ao arrancar"
}

node "TodoApi" {
  component AuthCtrl as "AuthController\nGET /api/auth/role"
}

database DB as "PortContext\n(AppUsers, Roles, UserRoles)"

SPA --> AuthCtrl : GET /api/auth/role\nwithCredentials
AuthCtrl --> DB : fetch AppUser + roles ativos
DB --> AuthCtrl : roles
AuthCtrl --> SPA : roles ou 403
SPA --> SPA : filtra menu/rotas por role

@enduml
