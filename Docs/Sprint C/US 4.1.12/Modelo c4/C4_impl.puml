@startuml C4_Incident_Types_Implementation_View
title C4 – Incident Types (Code-Level View)

skinparam class {
  BackgroundColor HoneyDew
  BorderColor Black
  FontColor Black
}

skinparam package {
  BackgroundColor White
  BorderColor Black
  FontStyle bold
}

package "frontend/src/app/pages" {
  class IncidentTypesComponent {
    -types: any[]
    -treeMode: boolean
    +loadTypes(): void
    +saveType(): void
    +deleteType(id: string|number): void
  }
}

package "frontend/src/app/services/incident-types" {
  class IncidentTypesService {
    +getIncidentTypes(q?: string): any
    +createIncidentType(payload: any): any
    +updateIncidentType(id: number, payload: any): any
    +deleteIncidentType(id: number): any
  }
}

package "TodoApi.Controllers" {
  class OemProxyController {
    +GetIncidentTypes(...)
    +CreateIncidentType(...)
    +UpdateIncidentType(...)
    +DeleteIncidentType(...)
  }
}

package "TodoApi.Services.Oem" {
  class OemClient {
    +GetIncidentTypesAsync(...)
    +CreateIncidentTypeAsync(...)
    +UpdateIncidentTypeAsync(...)
    +DeleteIncidentTypeAsync(...)
  }
}

package "oem-api/src/oem/controllers" {
  class IncidentTypeController {
    +findAll(...)
    +create(dto: any)
    +update(id: string, dto: any)
    +remove(id: string)
  }
}

IncidentTypesComponent --> IncidentTypesService
IncidentTypesService --> OemProxyController
OemProxyController --> OemClient
OemClient --> IncidentTypeController

@enduml
