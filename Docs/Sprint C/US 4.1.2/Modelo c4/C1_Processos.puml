@startuml C1_Generate_Operation_Plans_Process_View
title C1 – Generate Operation Plans (Process View)

actor "Logistics Operator" as Operator
participant "Generation UI\n(Angular Component)" as UI
participant "OemApiService" as SpaService
participant "TodoApi OemProxyController" as Controller
participant "OemClient" as Client
participant "OEM Planning Service" as OemService

Operator -> UI : Select date + algorithm
Operator -> UI : Click "Gerar Preview"
UI -> SpaService : previewOperationPlans(date, algorithm, vvnIds?)
SpaService -> Controller : POST /api/oem/operation-plans/preview
Controller -> Client : Forward POST
Client -> OemService : POST /oem/operation-plans/preview
OemService --> Client : Preview plans per VVN
Client --> Controller : HTTP 200
Controller --> SpaService : OperationPlanPreviewDto[]
SpaService --> UI : Render preview grid

Operator -> UI : Confirm selection & save
UI -> SpaService : generateOperationPlans(date, algorithm, vvnIds?)
SpaService -> Controller : POST /api/oem/operation-plans/generate
Controller -> Client : Forward POST
Client -> OemService : POST /oem/operation-plans/generate
OemService --> Client : Stored plans + metadata
Client --> Controller : HTTP 201 / 200
Controller --> SpaService : OperationPlanDto[]
SpaService --> UI : Show success + refresh saved list

@enduml
