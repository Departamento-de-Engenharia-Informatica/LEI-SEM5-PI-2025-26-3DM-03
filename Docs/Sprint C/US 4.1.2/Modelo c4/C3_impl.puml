@startuml C3_Generate_Operation_Plans_Implementation_View
title C3 – Plan Generation (Component View)
left to right direction
hide empty members

skinparam rectangle {
  BackgroundColor White
  BorderColor Black
  FontColor Black
  FontStyle bold
}

skinparam class {
  BackgroundColor HoneyDew
  BorderColor Black
  FontColor Black
}

package "Frontend Components" {
  class OemOperationPlansComponent {
    +onPreview()
    +onPersist()
    +selectedAsArray()
    +fetchMissingPlans()
  }
  class OemApiService {
    +previewOperationPlans(...)
    +generateOperationPlans(...)
    +getMissingOperationPlans(date)
    +regenerateMissingOperationPlans(...)
  }
  class VesselVisitSelector
  class SnackbarService
}

package "Backend Components" {
  class OemProxyController {
    +PreviewOperationPlans(request)
    +GenerateOperationPlans(request)
    +GetMissingOperationPlans(date)
    +RegenerateMissingOperationPlans(request)
  }
  class OemClient {
    +PreviewOperationPlansAsync(...)
    +GenerateOperationPlansAsync(...)
    +GetMissingOperationPlansAsync(...)
    +RegenerateMissingOperationPlansAsync(...)
    -ApplyIdentityHeaders(request)
  }
}

package "External Systems" {
  class OemPlanningApi
  class IdentityProvider
}

OemOperationPlansComponent --> OemApiService
OemOperationPlansComponent --> VesselVisitSelector
OemOperationPlansComponent --> SnackbarService
OemApiService --> OemProxyController
OemProxyController --> OemClient
OemClient --> OemPlanningApi
OemProxyController --> IdentityProvider : ensure auth

@enduml
