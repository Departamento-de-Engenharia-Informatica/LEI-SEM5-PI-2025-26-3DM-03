@startuml C4_VVE_Update_Sequence
title C4 – VVE Update (Sequence for PATCH)

autonumber

actor Operator
participant "VveDetailsComponent" as UI
participant "OemVveService" as FrontService
participant "VveProxyController" as ProxyController
participant "JwtMiddleware" as JwtMiddleware
participant "EtagValidator" as EtagValidator
participant "IdentityHeaderFactory" as HeaderFactory
participant "OemVveClient" as ProxyClient
participant "OEM VveController" as OemController
participant "VveUpdateService" as DomainService
participant "ConcurrencyGuard" as ConcurrencyGuard
participant "VveRepository" as VveRepo
participant "DockDiscrepancyChecker" as DiscrepancyChecker
participant "VvnRepository" as VvnRepo
participant "AuditPublisher" as AuditPublisher
participant "AuditLogWriter" as AuditWriter

Operator -> UI : Submit update form
UI -> FrontService : updateVve(vveId, payload)
FrontService -> ProxyController : PATCH /vves/{vveId}
ProxyController -> JwtMiddleware : validate token
JwtMiddleware --> ProxyController : ok
ProxyController -> EtagValidator : check payload.version
EtagValidator --> ProxyController : ok
ProxyController -> HeaderFactory : build headers
ProxyController -> ProxyClient : forward request
ProxyClient -> OemController : PATCH /vves/{vveId}
OemController -> DomainService : updateVve()
DomainService -> ConcurrencyGuard : ensureLatestVersion
ConcurrencyGuard -> VveRepo : load(vveId)
VveRepo --> ConcurrencyGuard : Vve aggregate
ConcurrencyGuard --> DomainService : ok
DomainService -> DiscrepancyChecker : compare docks
DiscrepancyChecker -> VvnRepo : fetch planned dock
VvnRepo --> DiscrepancyChecker : planned dock
DiscrepancyChecker --> DomainService : warnings[]
DomainService -> VveRepo : save(updated VVE)
VveRepo --> DomainService : persisted
DomainService -> AuditPublisher : publishVveUpdated(delta)
AuditPublisher -> AuditWriter : append audit entry
AuditPublisher --> DomainService : ack
DomainService --> OemController : VveDto
OemController --> ProxyClient : 200 + DTO
ProxyClient --> ProxyController : response
ProxyController --> FrontService : DTO
FrontService --> UI : Observable resolved
UI --> Operator : Show confirmation + warnings

@enduml
