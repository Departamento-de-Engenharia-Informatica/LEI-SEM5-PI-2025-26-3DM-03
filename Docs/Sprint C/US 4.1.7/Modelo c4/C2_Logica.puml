@startuml C2_VVE_Creation_Logical
title C2 – VVE Creation (Logical Containers)
left to right direction

node "Client Browser" as Browser {
  component "PLMS SPA" as Spa
}

node "PLMS Backend" as Backend {
  component "TodoApi" as TodoApi
}

node "OEM Platform" as Oem {
  component "Vve API" as VveApi
  database "VVN Store" as VvnStore
  database "VVE Store" as VveStore
  component "Audit Bus Producer" as AuditProducer
}

node "IAM" as Iam

Spa --> TodoApi : HTTPS POST /vvns/{id}/vves
TodoApi --> Iam : Token validation
TodoApi --> VveApi : Forward create request
VveApi --> VvnStore : Validate VVN / status
VveApi --> VveStore : Persist VVE (In Progress)
VveApi --> AuditProducer : Publish VVE_CREATED
VveApi --> TodoApi : VVE DTO
TodoApi --> Spa : VVE DTO
Spa --> Browser : Update status indicator

@enduml
