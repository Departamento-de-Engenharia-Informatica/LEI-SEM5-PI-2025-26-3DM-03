@startuml C4_VVE_Creation_Sequence
title C4 – VVE Creation (Sequence for POST)

autonumber

actor Operator
participant "VesselVisitExecutionComponent" as UI
participant "OemVveService" as FrontService
participant "VveProxyController" as ProxyController
participant "DuplicateGuard" as DuplicateGuard
participant "IdentityHeaderFactory" as HeaderFactory
participant "OemVveClient" as ProxyClient
participant "OEM VveController" as OemController
participant "VveApplicationService" as VveService
participant "VvnEligibilityChecker" as Eligibility
participant "VvnRepository" as VvnRepo
participant "VveFactory" as Factory
participant "VveIdGenerator" as IdGenerator
participant "VveRepository" as VveRepo
participant "AuditPublisher" as AuditPublisher

Operator -> UI : Submit arrival timestamp
UI -> FrontService : createVve(vvnId, payload)
FrontService -> ProxyController : POST /vvns/{vvnId}/vves
ProxyController -> DuplicateGuard : ensure no active VVE
DuplicateGuard --> ProxyController : ok
ProxyController -> HeaderFactory : build headers
ProxyController -> ProxyClient : Forward request
ProxyClient -> OemController : POST /vvns/{vvnId}/vves
OemController -> VveService : createVve(vvnId, payload, user)
VveService -> Eligibility : ensureCanCreateVve
Eligibility -> VvnRepo : findById(vvnId)
VvnRepo --> Eligibility : VVN entity
Eligibility --> VveService : ok
VveService -> Factory : create(vvn, payload, user)
Factory -> IdGenerator : next(vvn)
IdGenerator --> Factory : VVE id
Factory --> VveService : VVE aggregate
VveService -> VveRepo : save(VVE)
VveRepo --> VveService : persisted
VveService -> AuditPublisher : publishCreated(VVE)
AuditPublisher --> VveService : ack
VveService --> OemController : VveDto
OemController --> ProxyClient : 201 Created + DTO
ProxyClient --> ProxyController : 201 + DTO
ProxyController --> FrontService : DTO
FrontService --> UI : Observable resolved
UI --> Operator : Confirmation & status badge

@enduml
