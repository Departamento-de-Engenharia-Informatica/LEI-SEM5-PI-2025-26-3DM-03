@startuml C1_VVE_Creation_Context
title C1 – VVE Creation Scenario

actor "Logistics Operator" as Operator
rectangle "PLMS Portal" {
  package "Angular SPA" as Spa
}
rectangle "PLMS Backend" as Backend
rectangle "OEM Platform" as Oem
rectangle "Identity Provider" as Idp

Operator --> Spa : Select VVN & confirm arrival
Spa --> Backend : HTTPS (Create VVE)
Backend --> Oem : Forward create request
Oem --> Backend : VVE created response
Backend --> Spa : JSON with VVE details
Spa --> Operator : Show confirmation & status
Spa --> Idp : Authenticate session (OIDC)
Backend --> Idp : Token validation

@enduml
