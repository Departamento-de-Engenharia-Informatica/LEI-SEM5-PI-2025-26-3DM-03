@startuml C4_VVE_Creation_Implementation_View
title C4 – VVE Creation (Code-Level View)

skinparam class {
  BackgroundColor HoneyDew
  BorderColor Black
  FontColor Black
}

skinparam package {
  BackgroundColor White
  BorderColor Black
  FontStyle bold
}

package "frontend/src/app/oem/vve" {
  class VesselVisitExecutionComponent {
    -selectedVvn$: Observable<VvnSummary>
    -form: FormGroup
    -creating: boolean
    +ngOnInit(): void
    +onSubmit(): void
    +onCancel(): void
    -buildPayload(): CreateVveRequest
  }

  class VvnLookupService {
    +getEligibleVvns(): Observable<VvnSummary[]>
    +getVvnDetails(id: string): Observable<VvnDetails>
  }

  class OemVveService {
    +createVve(vvnId: string, payload: CreateVveRequest): Observable<VesselVisitExecution>
    +getCurrentVve(vvnId: string): Observable<VesselVisitExecution>
  }

  class CreateVveRequest {
    +string actualArrivalAt
  }

  class VesselVisitExecution {
    +string vveId
    +string vvnId
    +string vesselId
    +string status
    +string actualArrivalAt
    +string createdBy
    +string createdAt
  }
}

package "TodoApi.Controllers" {
  class VveProxyController {
    +CreateVve(vvnId, request)
    +GetCurrentVve(vvnId)
  }
}

package "TodoApi.Services.Oem" {
  class OemClient {
    +CreateVveAsync(vvnId, payload, token): Task<HttpResponseMessage>
    +GetCurrentVveAsync(vvnId, token): Task<HttpResponseMessage>
    -ApplyIdentityHeaders(request): void
  }
}

package "oem-api/src/vve" {
  class VveController {
    +create(vvnId, body, user): Promise<VveDto>
    +findCurrent(vvnId): Promise<VveDto>
  }

  class VveApplicationService {
    +create(vvnId, actualArrivalAt, userId): Promise<Vve>
    +findCurrent(vvnId): Promise<Vve?>
  }

  class VvnEligibilityChecker {
    +ensureCanCreateVve(vvnId): Promise<void>
  }

  class VveFactory {
    +create(vvn, actualArrivalAt, userId, clock): Vve
  }

  class VveRepository {
    +save(vve: Vve): Promise<void>
    +findActiveByVvn(vvnId): Promise<Vve?>
  }

  class VvnRepository {
    +findById(vvnId): Promise<Vvn>
  }

  class VveIdGenerator {
    +next(vvn): string
  }

  class AuditPublisher {
    +publishVveCreated(vve: Vve): Promise<void>
  }
}

VesselVisitExecutionComponent --> VvnLookupService
VesselVisitExecutionComponent --> OemVveService
OemVveService --> VveProxyController
VveProxyController --> OemClient
OemClient --> VveController
VveController --> VveApplicationService
VveApplicationService --> VvnEligibilityChecker
VveApplicationService --> VveFactory
VveApplicationService --> VveRepository
VveApplicationService --> AuditPublisher
VvnEligibilityChecker --> VvnRepository
VveFactory --> VveIdGenerator

@enduml
