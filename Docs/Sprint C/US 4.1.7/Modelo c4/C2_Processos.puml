@startuml C2_VVE_Creation_Process
title C2 – VVE Creation (Detailed Process)

skinparam ParticipantFontStyle bold
skinparam shadowing false

actor "Operator" as Operator
participant "VesselVisitExecutionComponent" as UI
participant "OemVveService" as FrontService
participant "VveProxyController" as Proxy
participant "IdentityHeaderFactory" as HeaderFactory
participant "OemClient" as Client
participant "OEM VveController" as OemController
participant "VveApplicationService" as AppService
participant "VvnEligibilityChecker" as Eligibility
participant "VvnRepository" as VvnRepo
participant "VveFactory" as VveFactory
participant "VveRepository" as VveRepo
participant "AuditPublisher" as Audit

Operator -> UI : Confirm arrival timestamp
UI -> FrontService : createVve(vvnId, timestamp)
FrontService -> Proxy : POST /vvns/{id}/vves
Proxy -> HeaderFactory : Build identity headers
Proxy -> Client : Forward request with JWT
Client -> OemController : POST /vvns/{id}/vves
OemController -> AppService : create(vvnId, timestamp, user)
AppService -> Eligibility : ensure VVN eligible
Eligibility -> VvnRepo : load VVN
VvnRepo --> Eligibility : VVN data
Eligibility --> AppService : eligibility ok
AppService -> VveFactory : new VVE entity
VveFactory --> AppService : VVE aggregate
AppService -> VveRepo : persist VVE (InProgress)
VveRepo --> AppService : saved VVE
AppService -> Audit : publish VVE_CREATED
Audit --> AppService : ack
AppService --> OemController : VVE DTO
OemController --> Client : 201 Created
Client --> Proxy : 201 Created
Proxy --> FrontService : VVE DTO
FrontService --> UI : Promise resolved
UI --> Operator : Confirmation & status update

@enduml
