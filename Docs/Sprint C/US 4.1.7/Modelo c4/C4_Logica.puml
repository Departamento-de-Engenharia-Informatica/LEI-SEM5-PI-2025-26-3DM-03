@startuml C4_VVE_Creation_Logical_View
title C4 – VVE Creation (Detailed Component Interaction)
left to right direction

skinparam componentStyle rectangle
skinparam component {
  BackgroundColor HoneyDew
  BorderColor Black
}

component "VesselVisitExecutionComponent" as ListView
component "VvnLookupService" as LookupService
component "VveConfirmationDialog" as ConfirmationDialog
component "OemVveService" as FrontService

component "TodoApi VveProxyController" as ProxyController
component "JwtMiddleware" as JwtMiddleware
component "DuplicateGuard" as DuplicateGuard
component "IdentityHeaderFactory" as HeaderFactory
component "OemVveClient" as ProxyClient

component "OEM VveController" as OemController
component "VveApplicationService" as VveService
component "VvnEligibilityChecker" as Eligibility
component "VveIdGenerator" as IdGenerator
component "VveFactory" as Factory
component "VveRepository" as VveRepo
component "VvnRepository" as VvnRepo
component "AuditPublisher" as AuditPublisher

ListView --> LookupService : load eligible VVNs
ListView --> ConfirmationDialog : prepare arrival summary
ListView --> FrontService : submit create request
FrontService --> ProxyController : HTTPS JSON
ProxyController --> JwtMiddleware : authorize
ProxyController --> DuplicateGuard : ensure no active VVE
ProxyController --> HeaderFactory : build identity headers
ProxyController --> ProxyClient : outbound call
ProxyClient --> OemController : REST
OemController --> VveService : createVve
VveService --> Eligibility : validate VVN status
Eligibility --> VvnRepo : fetch VVN
VvnRepo --> Eligibility : VVN data
VveService --> Factory : build VVE aggregate
Factory --> IdGenerator : assign VVE id
Factory --> VveService : VVE entity
VveService --> VveRepo : persist VVE
VveRepo --> VveService : saved VVE
VveService --> AuditPublisher : publish event
AuditPublisher --> VveService : ack
VveService --> OemController : VVE DTO
OemController --> ProxyClient : response
ProxyClient --> ProxyController : response
ProxyController --> FrontService : DTO
FrontService --> ListView : update view

@enduml
