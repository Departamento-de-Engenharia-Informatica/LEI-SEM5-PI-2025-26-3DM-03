@startuml C3_VVE_Creation_Process_View
title C3 – VVE Creation (Process Flow)

skinparam ParticipantFontStyle bold
skinparam shadowing false

actor "Logistics Operator" as Operator
participant "VesselVisitExecutionComponent" as UI
participant "OemVveService" as FrontService
participant "VveProxyController" as Proxy
participant "DuplicateGuard" as Guard
participant "OemClient" as Client
participant "OEM VveController" as OemController
participant "VveApplicationService" as AppService
participant "VvnEligibilityChecker" as Eligibility
Database "VVN Store" as VvnDb
participant "VveFactory" as Factory
Database "VVE Store" as VveDb
participant "AuditPublisher" as Audit
component "Audit Topic" as AuditTopic

Operator -> UI : Confirm create VVE
UI -> FrontService : POST create
FrontService -> Proxy : POST /vvns/{id}/vves
Proxy -> Guard : HasActiveVve(vvnId)?
Guard --> Proxy : none found
Proxy -> OemClient : Forward with JWT
OemClient -> OemController : POST /vvns/{id}/vves
OemController -> AppService : create(vvnId, arrival, user)
AppService -> Eligibility : Validate VVN status
Eligibility -> VvnDb : load VVN
VvnDb --> Eligibility : VVN data
Eligibility --> AppService : ok
AppService -> Factory : build entity
Factory --> AppService : VVE aggregate
AppService -> VveDb : persist VVE (InProgress)
AppService -> Audit : publish event
Audit -> AuditTopic : VVE_CREATED
AppService --> OemController : VVE DTO
OemController --> OemClient : 201 + DTO
OemClient --> Proxy : 201 + DTO
Proxy --> FrontService : DTO
FrontService --> UI : Response
UI --> Operator : Confirmation + In Progress badge

@enduml
