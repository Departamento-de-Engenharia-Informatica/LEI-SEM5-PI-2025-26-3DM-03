@startuml C3_VVE_Execution_Physical_View
title C3 – VVE Execution (Physical / Deployment View)
left to right direction

skinparam node {
  BackgroundColor White
  BorderColor Black
  FontStyle bold
}

skinparam artifact {
  BackgroundColor HoneyDew
  BorderColor Black
}

skinparam database {
  BackgroundColor Wheat
  BorderColor Black
}

actor "Logistics Operator" as Operator

node "User Device" as Device {
  artifact "Angular SPA" as Spa
}

node "PLMS Backend" as Backend {
  artifact ".NET TodoApi" as TodoApi
}

node "OEM Platform" as Platform {
  artifact "OEM API Pod" as OemApi
  artifact "Execution Worker" as ExecutionWorker
  database "Planned Ops DB" as PlannedDb
  database "Executed Ops DB" as ExecutedDb
  database "VVE DB" as VveDb
}

node "Operation Plan Cluster" as PlanCluster {
  artifact "Plan Sync Consumer" as PlanConsumer
  database "Operation Plan DB" as PlanDb
}

node "IAM Cluster" as Identity {
  artifact "OIDC Provider" as Idp
}

node "Event Bus" as Bus {
  artifact "Execution Events Topic" as ExecTopic
  artifact "Plan Sync Topic" as PlanTopic
}

Operator --> Spa : HTTPS
Spa --> TodoApi : REST (bulk execution update)
TodoApi --> OemApi : HTTPS
OemApi --> ExecutionWorker : Dispatch command
ExecutionWorker --> PlannedDb : Read planned ops
ExecutionWorker --> ExecutedDb : Persist actual data
ExecutionWorker --> VveDb : Update progress
ExecutionWorker --> ExecTopic : Publish execution events
ExecutionWorker --> PlanTopic : Publish plan sync events
PlanTopic --> PlanConsumer : Consume sync
PlanConsumer --> PlanDb : Update plan status
OemApi --> TodoApi : Response with summary
TodoApi --> Spa : JSON response
TodoApi --> Idp : Token introspection
Spa --> Idp : Login/OAuth flow

@enduml
