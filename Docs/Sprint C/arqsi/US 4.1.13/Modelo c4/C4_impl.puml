@startuml C4_Incidents_Implementation_View
title C4 – Incidents (Code-Level View)

skinparam class {
  BackgroundColor HoneyDew
  BorderColor Black
  FontColor Black
}

skinparam package {
  BackgroundColor White
  BorderColor Black
  FontStyle bold
}

package "frontend/src/app/pages" {
  class IncidentsComponent {
    -incidents: any[]
    +loadIncidents(): void
    +saveIncident(): void
    +deleteIncident(id: string|number): void
    +loadAffectedVves(incidentId: string|number): void
  }
}

package "frontend/src/app/services/incidents" {
  class IncidentsService {
    +getIncidents(filters?: any): any
    +createIncident(payload: any): any
    +updateIncident(id: number, payload: any): any
    +deleteIncident(id: number): any
    +getAffectedVesselVisitExecutions(id: number): any
  }
}

package "TodoApi.Controllers" {
  class OemProxyController {
    +GetIncidents(...)
    +CreateIncident(...)
    +UpdateIncident(...)
    +DeleteIncident(...)
    +GetAffectedVesselVisitExecutions(...)
  }
}

package "TodoApi.Services.Oem" {
  class OemClient {
    +GetIncidentsAsync(...)
    +CreateIncidentAsync(...)
    +UpdateIncidentAsync(...)
    +DeleteIncidentAsync(...)
    +GetAffectedVesselVisitExecutionsAsync(...)
  }
}

package "oem-api/src/oem/controllers" {
  class IncidentController {
    +findAll(...)
    +create(dto: any)
    +update(id: string, dto: any)
    +remove(id: string)
    +affectedVesselVisitExecutions(id: string)
  }
}

IncidentsComponent --> IncidentsService
IncidentsService --> OemProxyController
OemProxyController --> OemClient
OemClient --> IncidentController

@enduml
