@startuml C3_Incidents_System_Sequence
title C3 – Incidents (System Sequence)
hide footbox

actor "Logistics Operator" as Operator
participant "IncidentsComponent" as Component
participant "IncidentsService" as SpaService
participant "OemProxyController" as Controller
participant "OemClient" as Client
participant "OEM Execution API" as OemApi
participant "Incident Validator" as Validator

Operator -> Component : Save incident
Component -> SpaService : validate & build payload
SpaService -> Controller : POST/PATCH /api/oem/incidents
Controller -> Client : Forward + identity
Client -> OemApi : POST/PATCH /incidents
OemApi -> Validator : Validate scope/type/date
alt Valid
  Validator --> OemApi : OK
  OemApi --> Client : 200/201
else Invalid
  Validator --> OemApi : Errors
  OemApi --> Client : 400
end
Client --> Controller : Forward
Controller --> SpaService : JSON
SpaService --> Component : refresh UI

@enduml
