@startuml C2_Search_Operation_Plans_Logical_View
title C2 – Operation Plan Search (Container View)

skinparam rectangle {
  BackgroundColor White
  BorderColor Black
  FontColor Black
  FontStyle bold
}
skinparam cloud {
  BackgroundColor LightGray
  BorderColor Black
  FontColor Black
}
skinparam database {
  BackgroundColor Wheat
  BorderColor Black
  FontColor Black
}
skinparam actor {
  BackgroundColor CornflowerBlue
  BorderColor Black
  FontColor White
}

actor "Logistics Operator" as Operator

rectangle "Frontoffice SPA" as SPA {
  rectangle "Operation Plans Feature" as Feature
  rectangle "Table & Sorting Utilities" as TableUtils
}

rectangle "TodoApi" as Gateway {
  rectangle "OemProxyController" as Controller
  rectangle "OemClient" as Client
}

cloud "OEM Service" as OEM {
  rectangle "REST API" as Rest
  rectangle "Query Handlers" as Queries
}

cloud "IAM" as IAM

database "OEM Database" as Db

Operator --> Feature : UI interaction
Feature --> Controller : HTTP GET with filters
Controller --> Client : Compose OEM request
Client --> Rest : GET /operation-plans
Rest --> Queries : Build query specification
Queries --> Db : Execute filter + sort
Db --> Queries : Result set
Queries --> Rest : DTO list
Rest --> Client : JSON
Client --> Controller : Proxied response
Controller --> Feature : Return plans
Feature --> TableUtils : Apply client sort/pagination
Controller --> IAM : Validate token (upstream) 

@enduml
