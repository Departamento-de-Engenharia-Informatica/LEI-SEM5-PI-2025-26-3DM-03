@startuml US_3_1_3_C2_Impl
title US 3.1.3 - Menus por role (Implementacao)

node "Browser" {
  component Layout as "LayoutComponent\nmenu dinamico"
  component Guard as "AuthGuard\nvalida roles exigidos"
}

component MenuData as "menuItems (TS)\nrole[] por rota"
component Auth as "AuthService\nperfil + roles\n/authtest/me"

Layout --> Auth : obter roles ativos
Layout --> MenuData : filtra itens
Guard --> Auth : validar roles
Guard --> Layout : permite ou bloqueia rota

@enduml
