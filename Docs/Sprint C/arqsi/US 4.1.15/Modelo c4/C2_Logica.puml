@startuml C2_Complementary_Tasks_Logical_View
title C2 – PLMS Containers for Complementary Tasks

skinparam rectangle {
  BackgroundColor White
  BorderColor Black
  FontColor Black
  FontStyle bold
}
skinparam database {
  BackgroundColor Wheat
  BorderColor Black
  FontColor Black
}
skinparam cloud {
  BackgroundColor LightGray
  BorderColor Black
  FontColor Black
}
skinparam actor {
  BackgroundColor CornflowerBlue
  BorderColor Black
  FontColor White
}

actor "Logistics Operator" as Operator

rectangle "Port Logistics Management System" as PLMS {
  rectangle "Angular SPA" as SPA {
    rectangle "Complementary Tasks Feature" as Feature
    rectangle "ComplementaryTasksService" as ApiService
  }

  rectangle "TodoApi (ASP.NET Core)" as Api {
    rectangle "OemProxyController" as Controller
    rectangle "OemClient" as Client
  }
}

cloud "Identity Provider" as IAM
cloud "OEM Operational Execution Service" as OEM

database "OEM Operational Store" as Db

Operator --> Feature : Browser interaction
Feature --> ApiService : service calls
ApiService --> Controller : REST JSON
Controller --> IAM : identity headers
Controller --> Client : forward
Client --> OEM : HTTPS
OEM --> Db : persist
OEM --> Controller : JSON

@enduml
