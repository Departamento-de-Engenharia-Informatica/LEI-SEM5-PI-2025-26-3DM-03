@startuml C3_Complementary_Tasks_Logical_View
title C3 – Complementary Tasks (Logical Architecture)
left to right direction
hide empty members

skinparam rectangle {
  BackgroundColor White
  BorderColor Black
  FontColor Black
  FontStyle bold
}
skinparam database {
  BackgroundColor Wheat
  BorderColor Black
  FontColor Black
}
skinparam actor {
  BackgroundColor CornflowerBlue
  BorderColor Black
  FontColor White
}

actor "Logistics Operator" as Operator

rectangle "Angular SPA" as SPA {
  rectangle "Complementary Tasks Feature" as Feature
  rectangle "UI Forms / Filters" as Shared
}

rectangle "TodoApi Gateway" as Api {
  rectangle "OemProxyController" as Controller
  rectangle "OemClient" as Client
  rectangle "Identity Middleware" as Identity
}

cloud "OEM Operational Execution Service" as OEM

database "OEM Operational Store" as Db

Operator --> Feature
Feature --> Shared : validate inputs
Feature --> Controller : REST
Controller --> Identity : auth
Controller --> Client : OEM calls
Client --> OEM : CRUD tasks
OEM --> Db : persist
OEM --> Controller : JSON

@enduml
