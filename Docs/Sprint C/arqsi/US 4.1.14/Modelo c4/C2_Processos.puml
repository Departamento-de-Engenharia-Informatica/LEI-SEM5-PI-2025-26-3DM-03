@startuml C2_Complementary_Task_Categories_Detailed_Sequence
title C2 – Complementary Task Categories (Detailed Sequence)
hide footbox

actor "Logistics Operator" as Operator
participant "ComplementaryTaskCategoriesComponent" as Component
participant "ComplementaryTaskCategoriesService" as SpaService
participant "TodoApi OemProxyController" as Controller
participant "OemClient" as Client
participant "OEM Execution API" as OemApi
participant "Category Validator" as Validator

== Load/search ==
Operator -> Component : Open page / search (q)
Component -> SpaService : getAll(q)
SpaService -> Controller : GET /api/oem/complementary-task-categories?q=...
Controller -> Client : Forward
Client -> OemApi : GET /complementary-task-categories?q=...
OemApi --> Client : 200 OK categories[]
Client --> Controller : Forward
Controller --> SpaService : categories[]
SpaService --> Component : update UI

== Create/update ==
Operator -> Component : Save category
Component -> SpaService : create/update(payload)
SpaService -> Controller : POST/PATCH /api/oem/complementary-task-categories
Controller -> Client : Forward + identity
Client -> OemApi : POST/PATCH /complementary-task-categories
OemApi -> Validator : Validate code format
alt Valid
  OemApi --> Client : 200/201
else Invalid
  OemApi --> Client : 400
end
Client --> Controller : Forward
Controller --> SpaService : JSON
SpaService --> Component : refresh

@enduml
