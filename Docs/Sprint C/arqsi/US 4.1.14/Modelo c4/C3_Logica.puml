@startuml C3_Complementary_Task_Categories_Logical_View
title C3 – Complementary Task Categories (Logical Architecture)
left to right direction
hide empty members

skinparam rectangle {
  BackgroundColor White
  BorderColor Black
  FontColor Black
  FontStyle bold
}
skinparam database {
  BackgroundColor Wheat
  BorderColor Black
  FontColor Black
}
skinparam actor {
  BackgroundColor CornflowerBlue
  BorderColor Black
  FontColor White
}

actor "Logistics Operator" as Operator

rectangle "Angular SPA" as SPA {
  rectangle "CT Categories Feature" as Feature
  rectangle "UI Forms" as Shared
}

rectangle "TodoApi Gateway" as Api {
  rectangle "OemProxyController" as Controller
  rectangle "OemClient" as Client
  rectangle "Identity Middleware" as Identity
}

cloud "OEM Operational Execution Service" as OEM

database "OEM Operational Store" as Db

Operator --> Feature
Feature --> Shared : validate code/name
Feature --> Controller : REST
Controller --> Identity : auth
Controller --> Client : OEM calls
Client --> OEM : CRUD categories
OEM --> Db : persist
OEM --> Controller : JSON

@enduml
