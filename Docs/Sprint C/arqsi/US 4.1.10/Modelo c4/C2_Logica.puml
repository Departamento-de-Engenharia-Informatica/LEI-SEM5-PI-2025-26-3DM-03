@startuml C2_Manage_VVE_Logical_View
title C2 – PLMS Containers for Vessel Visit Executions

skinparam rectangle {
  BackgroundColor White
  BorderColor Black
  FontColor Black
  FontStyle bold
}
skinparam database {
  BackgroundColor Wheat
  BorderColor Black
  FontColor Black
}
skinparam cloud {
  BackgroundColor LightGray
  BorderColor Black
  FontColor Black
}
skinparam actor {
  BackgroundColor CornflowerBlue
  BorderColor Black
  FontColor White
}

actor "Logistics Operator" as Operator

rectangle "Port Logistics Management System" as PLMS {
  rectangle "Angular SPA" as SPA {
    rectangle "VVE History Feature" as Feature
    rectangle "OemApiService" as ApiService
    rectangle "Reference Data Services\n(Docks/Berths)" as Reference
  }

  rectangle "TodoApi (ASP.NET Core)" as Api {
    rectangle "OemProxyController" as Controller
    rectangle "OemClient" as Client
  }
}

cloud "Identity Provider" as IAM
cloud "OEM Operational Execution Service" as OEM
cloud "Support Catalog Services" as Catalogs

database "OEM Operational Store" as OemDb

database "Local Cache / Browser Storage" as Cache

Operator --> Feature : Browser interaction (HTTPS)
Feature --> ApiService : Angular service calls
ApiService --> Controller : REST JSON (with credentials)
Controller --> Client : Forward OEM requests
Client --> OEM : HTTPS API calls
Controller --> IAM : Adds identity headers
ApiService --> Reference : dropdown lookups
Reference --> Catalogs : fetch metadata
Feature --> Cache : optional caching

OEM --> OemDb : Persist VVEs + audit
OEM --> Controller : VVEs / audit JSON
Catalogs --> Reference : docks/berths

@enduml
