@startuml C2_Create_Vessel_Visit_Execution_Logical_View
title C2 – OEM Module (Create Vessel Visit Execution - Logical Container View)

skinparam rectangle {
  BackgroundColor White
  BorderColor Black
  FontColor Black
  FontStyle bold
}
skinparam database {
  BackgroundColor Wheat
  BorderColor Black
  FontColor Black
}
skinparam cloud {
  BackgroundColor LightGray
  BorderColor Black
  FontColor Black
}
skinparam actor {
  BackgroundColor CornflowerBlue
  FontColor White
  BorderColor Black
}

' === Atores Externos ===
actor "Logistics Operator" as LogisticsOp

' === Sistema Externo ===
cloud "External IAM Provider\n(OAuth 2.0)" as IAM

' === Sistema em foco ===
rectangle "Port Logistics Management System (PLMS)" as PLMS {
  rectangle "Frontend\n(Angular SPA)" as Frontend
  rectangle "OEM API\n(NestJS + TypeORM)" as API
  database "Database\n(PostgreSQL/SQLite)" as DB
}

' === Relações ===
LogisticsOp --> Frontend : Browser (HTTPS)
Frontend --> API : REST (JSON) - Create/Update VVE
API --> DB : TypeORM (SQL) - Persist VVE
API --> IAM : Bearer Token (OAuth 2.0)

@enduml
@enduml
