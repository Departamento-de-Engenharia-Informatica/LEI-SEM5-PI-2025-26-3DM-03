@startuml C3_Create_Vessel_Visit_Execution_Logical_View
title C3 – Create Vessel Visit Execution API (Logical View)
left to right direction
hide empty members

skinparam rectangle {
  BackgroundColor White
  BorderColor Black
  FontColor Black
  FontStyle bold
}
skinparam database {
  BackgroundColor Wheat
  BorderColor Black
  FontColor Black
}
skinparam actor {
  BackgroundColor CornflowerBlue
  FontColor White
  BorderColor Black
}

actor "Logistics Operator" as LogisticsOp

rectangle "Port Logistics Management System (PLMS)" as PLMS {
  
  rectangle "Vessel Visit Execution API\n(ASP.NET Core Web API)" as API
  rectangle "VVEService\n(Lógica de Negócio)" as Service
  rectangle "VVEMapper\n(Conversão DTO ↔ Model)" as Mapper
  rectangle "PortContext\n(Entity Framework Core)" as Context
}

database "Database System\n(SQL / InMemory)" as DB
rectangle "External IAM Provider\n(SSO / OAuth 2.0)" as IAM

' === RELAÇÕES ===
LogisticsOp --> API : Create VVE (HTTP/JSON)
LogisticsOp --> IAM : Autentica-se via OAuth 2.0
API --> IAM : Validação de token
API --> Mapper : Conversão de objetos
API --> Service : Validação VVN, geração VVE ID, marcação "In Progress"
Service --> Context : Operações de leitura/escrita (EF Core)
Context --> DB : Persistência de VVE

@enduml
