@startuml C1_Create_Vessel_Visit_Execution_Logical_View
title C1 – Create Vessel Visit Execution (Logical View)

' === Atores Externos ===
actor "Logistics Operator" as LogisticsOp
rectangle "External IAM Provider\n(OAuth 2.0)" as IAM
database "Database\n(PostgreSQL / SQLite)" as DB

' === Sistema em Foco ===
package "Port Logistics Management System (PLMS)" {
    rectangle "OEM API\n(NestJS + TypeORM)" as API
    rectangle "VVEService\n(Business Logic)" as Service
}

' === Relações ===
LogisticsOp --> IAM : Autentica-se via OAuth 2.0
LogisticsOp --> API : Create VVE (HTTP/JSON)
API --> IAM : Validação de token
API --> Service : VVN validation, ID generation
Service --> DB : Persistência de VVE (TypeORM)

' === Estilo visual ===
skinparam rectangle {
  BackgroundColor<<System>> LightGray
  BackgroundColor<<Component>> HoneyDew
  BorderColor Black
  FontColor Black
}
skinparam actor {
  BackgroundColor CornflowerBlue
  FontColor White
  BorderColor Black
}
skinparam database {
  BackgroundColor Wheat
  FontColor Black
}

@enduml

@enduml
