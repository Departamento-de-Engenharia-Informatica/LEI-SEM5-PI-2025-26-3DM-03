@host = https://localhost:7443

### Get all OEMs
GET {{host}}/api/oems

### Create new OEM
POST {{host}}/api/oems
Content-Type: application/json

{
  "code": "OEM-001",
  "name": "Example OEM",
  "country": "Portugal",
  "segment": "Electrical",
  "contactEmail": "contact@example.com",
  "contactPhone": "+351900000000",
  "active": true
}
